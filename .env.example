# Rename this file to .env and fill in your key before running

# Free key (no card): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=your_gemini_api_key_here

# Main model, then fallbacks tried in order if it is busy or unavailable.
# flash-lite is the fastest (minimal "thinking") — best for this app's short JSON answers.
# Current stable models (Sept 2026): gemini-3.5-flash-lite, gemini-3.6-flash, gemini-3.8-flash
# (the older 2.5 models are no longer available to new API keys)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash

# Server port (optional, defaults to 3000)
PORT=3000
